# Database. Any Postgres works (Supabase, Neon, RDS...). Use the *pooled* connection string on Vercel.
# Leave blank in local development to use an embedded Postgres (PGlite) stored in .data/pg.
# Required in production. Migrations and the colleges seed run automatically on first request.
DATABASE_URL=
# Optional: max connections per server instance (defaults: 3 on Vercel, 10 elsewhere). Keep small on free tiers.
# DATABASE_POOL_MAX=

# Admin dashboard password (/admin). Required in production; defaults to "admin" in local dev only.
ADMIN_PASSWORD=

# AI (project scoring + campus-kit messages) is configured in the admin panel: /admin/ai
# Pick a local model (Ollama / LM Studio) or add a hosted API key. Keys are stored encrypted in the database.
# Passphrase used to encrypt them. Falls back to ADMIN_PASSWORD if blank. Changing it means re-entering the key.
SETTINGS_SECRET=
# Legacy fallback: used only until AI is configured in the admin panel.
# ANTHROPIC_API_KEY=

# Optional: max size of a student zip/video upload in MB. Default 25 locally, 4 on Vercel (its hard request limit is ~4.5 MB).
# MAX_UPLOAD_MB=

# Optional: the public URL, used in referral links. Detected from the request if blank.
NEXT_PUBLIC_SITE_URL=
