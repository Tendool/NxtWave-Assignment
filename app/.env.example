# Database. Any Postgres works (Supabase, Neon, RDS...). Use the *pooled* connection string on Vercel.
# Leave blank in local development to use an embedded Postgres (PGlite) stored in .data/pg.
# Required in production. Migrations and the colleges seed run automatically on first request.
DATABASE_URL=
# Optional: max connections per server instance (defaults: 3 on Vercel, 10 elsewhere). Keep small on free tiers.
# DATABASE_POOL_MAX=

# Admin dashboard password (/admin). Required in production; defaults to "admin" in local dev only.
ADMIN_PASSWORD=

# Optional: enables AI project scoring and AI-written ambassador messages.
# Without it, the evaluator does a basic automated check and the kit uses templates.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: the public URL, used in referral links. Detected from the request if blank.
NEXT_PUBLIC_SITE_URL=
